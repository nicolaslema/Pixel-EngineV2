{
  "name": "pixel-engine",
  "version": "1.0.0",
  "description": "A high-performance typed-array based pixel simulation engine.",
  "author": "nicolaslema",
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicolaslema/pixel-engine.git"
  },
  "bugs": {
    "url": "https://github.com/nicolaslema/pixel-engine/issues"
  },
  "homepage": "https://github.com/nicolaslema/pixel-engine#readme",
  "keywords": [
    "pixel",
    "canvas",
    "engine",
    "effects",
    "animation",
    "reactive"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "dependencies": {
    "@pixel-engine/core": "^1.0.0",
    "@pixel-engine/effects": "^1.0.0"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "dev:react": "vite --open /react.html",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"packages/*/src/**/*.{ts,tsx}\" \"playground/**/*.{ts,tsx}\" \"scripts/**/*.{mjs,cjs}\"",
    "format": "prettier --write \"src/**/*.ts\" \"packages/*/src/**/*.{ts,tsx}\" \"playground/**/*.{ts,tsx}\" \"scripts/**/*.{mjs,cjs}\"",
    "build:packages": "npm run build -w @pixel-engine/core && npm run build -w @pixel-engine/effects && npm run build -w @pixel-engine/react",
    "build:all": "npm run build:packages && npm run build",
    "bench:pixelgrid": "npm run build:all && node scripts/bench/pixelgrid-bench.cjs --suite=all --runs=3",
    "bench:pixelgrid:classic": "npm run build:all && node scripts/bench/pixelgrid-bench.cjs --suite=classic --runs=5",
    "bench:pixelgrid:stress": "npm run build:all && node scripts/bench/pixelgrid-bench.cjs --suite=stress --runs=5",
    "bench:pixelgrid:all": "npm run build:all && node scripts/bench/pixelgrid-bench.cjs --suite=all --runs=5",
    "bench:pixelgrid:ripplestorm": "npm run build:all && node scripts/bench/pixelgrid-bench.cjs --suite=rippleStorm --runs=5",
    "bench:transition": "npm run build:all && node scripts/bench/pixelgrid-transition-bench.cjs --mode=all --scenario=all --runs=3",
    "bench:transition:all": "npm run build:all && node scripts/bench/pixelgrid-transition-bench.cjs --mode=all --scenario=all --runs=5",
    "bench:transition:legacy": "npm run build:all && node scripts/bench/pixelgrid-transition-bench.cjs --mode=all --scenario=text-image --runs=5",
    "bench:transition:multi": "npm run build:all && node scripts/bench/pixelgrid-transition-bench.cjs --mode=all --scenario=multi-mask --runs=5",
    "bench:transition:morph": "npm run build:all && node scripts/bench/pixelgrid-transition-bench.cjs --mode=morph --scenario=all --runs=5",
    "bench:transition:fade": "npm run build:all && node scripts/bench/pixelgrid-transition-bench.cjs --mode=fade --scenario=all --runs=5",
    "bench:transition:dissolve": "npm run build:all && node scripts/bench/pixelgrid-transition-bench.cjs --mode=dissolve --scenario=all --runs=5",
    "verify": "npm run lint && npm run test && npm run build:all && npm run typecheck",
    "release:docs:prepare": "node scripts/release/prepare-release-docs.mjs",
    "release:docs:check": "node scripts/release/check-release-docs.mjs",
    "release:pack:verify": "node scripts/release/verify-packages.mjs",
    "pack:dry": "npm pack --dry-run && npm pack --dry-run -w @pixel-engine/core && npm pack --dry-run -w @pixel-engine/effects && npm pack --dry-run -w @pixel-engine/react",
    "smoke:consumer": "node scripts/smoke-consumer.mjs",
    "release:check": "npm run verify && npm run release:docs:check && npm run pack:dry && npm run release:pack:verify && npm run smoke:consumer",
    "build:playground": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:visual": "vitest run packages/effects/src/entities/pixel-grid/visual-baseline.test.ts",
    "prepublishOnly": "npm run release:check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.8.0",
    "jsdom": "^28.1.0",
    "prettier": "3.9.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "8.65.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
